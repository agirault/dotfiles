# Shared ssh settings. Private hosts stay in ~/.ssh/config.local, which this
# repository does not contain.
#
# ssh keeps the first value it finds for each option, so the order matters.
# Include comes first, to let a host in config.local set its own values. The
# Host * block comes last, to supply a value only where none was set.

Include ~/.ssh/config.local

Host *
  # Add the key to the agent the first time it is used. You then type the
  # passphrase once per login instead of once per connection.
  AddKeysToAgent yes

  # UseKeychain puts the passphrase in the macOS login Keychain, so you do not
  # type it again after a restart. Linux ssh has no such option, and it stops
  # with an error when it reads a keyword it does not know, so IgnoreUnknown
  # must come first. On Linux the agent above does the caching instead.
  IgnoreUnknown UseKeychain
  UseKeychain yes

  # Find a dead connection, and stop a NAT or firewall from closing an idle one.
  ServerAliveInterval 60
