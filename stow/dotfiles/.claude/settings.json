{
  "permissions": {
    "allow": [
      "Bash"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-cleanup-session.py",
            "timeout": 5,
            "async": true
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-name-session.py",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/executable_statusline.sh"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowAllUnixSockets": true
    },
    "filesystem": {
      "allowRead": ["~/"]
    }
  },
  "env": {
    "GIT_CONFIG_GLOBAL": "~/.gitconfig.local"
  },
  "effortLevel": "high",
  "autoMemoryDirectory": "~/.claude/memory",
  "enabledPlugins": {
    "slack@claude-plugins-official": true
  }
}
